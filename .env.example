# Copy to .env and adjust (never commit .env)

# development | production
ENV=development

# Server bind address (use 127.0.0.1 locally; 0.0.0.0 only behind a firewall/reverse proxy)
HOST=127.0.0.1
PORT=8000

# Required for any public deployment — clients send header: X-API-Key: <value>
# API_KEY=generate-a-long-random-secret

# Comma-separated allowed browser origins (leave empty to disable CORS)
# CORS_ORIGINS=https://app.example.com

# OpenAPI docs (/docs) — disabled automatically when ENV=production
ENABLE_DOCS=true

# Request limits
MAX_UPLOAD_BYTES=10485760
MAX_TTS_CHARS=2000
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Legacy standalone servers (api/asr.py) — keep false
ENABLE_LEGACY_APIS=false
ENABLE_TRAINING_API=false

# ASR
ASR_LAZY_LOAD=true
WHISPER_MODEL_SIZE=tiny
